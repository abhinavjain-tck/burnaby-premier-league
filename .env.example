# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Transaction pooler (port 6543) for Drizzle
DATABASE_URL=
# Comma-separated Gmail addresses that get super_admin on first sign-in
SUPER_ADMIN_EMAILS=
# Protects /api/cron/keepalive
CRON_SECRET=
# Fee step on /register, e.g. "League fee: 50 CAD" and the e-Transfer address.
# Baked in at build time, so redeploy after changing.
NEXT_PUBLIC_FEE_TEXT=
NEXT_PUBLIC_ETRANSFER_EMAIL=
